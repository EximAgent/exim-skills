# =============================================================================
# Trade Company Agent — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
#
# Then source it before running the skills:
#   source .env
# =============================================================================

# -- Typesense (required) --
TYPESENSE_API_KEY=xyz
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_COLLECTION=companies

# -- API Keys (at least GEMINI_API_KEY is required) --
GEMINI_API_KEY=your_gemini_api_key_here
SERPER_API_KEY=your_serper_api_key_here
CLOUDFLARE_API_KEY=your_cloudflare_api_key_here
CF_ACCOUNT_ID=your_cloudflare_account_id

# -- ClickHouse --
CLICKHOUSE_HOST=your_host.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_password
CLICKHOUSE_DATABASE=exim
CLICKHOUSE_SECURE=true
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# -- Model Configuration --
# These reference config keys in .claude/skills/models.yaml
# Change these to switch providers/models without editing code.
#
# Available configs (see models.yaml for full list):
#   Gemini:    gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash
#   OpenAI:    gpt-4o, gpt-4o-mini, gpt-4.1
#   Anthropic: claude-sonnet-4, claude-opus-4
#   Embedding: gemini-embedding-001, gemini-embedding-2-preview, openai-text-embedding-3-small

KNOWLEDGE_MODEL_CONFIG=gemini-3.1-pro-preview
EMBEDDING_MODEL_CONFIG=gemini-embedding-2-preview

# -- Pipeline (pipeline.py) --
AGENT_MODEL=haiku                 # claude model: haiku, sonnet, opus (uses your Claude Code subscription)
AGENT_MAX_BUDGET=0.5
AGENT_MAX_TURNS=15
# Optional: custom API endpoint (z.ai, OpenRouter, etc.)
# AGENT_API_BASE_URL=https://api.z.ai/api/anthropic
# AGENT_API_KEY=your_api_key_here
